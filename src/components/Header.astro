---
import YoutubeNavbar from "./icons/YoutubeNavbar.astro";
---

<header
  class="flex justify-center items-center mx-auto py-3 sm:py-5 sticky top-0 w-full xl:w-[1120px] z-10"
>
  <nav
    class="flex flex-row items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 rounded-full border border-white/10
           bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md shadow-lg w-auto"
  >
    <a
      href="#experiencia"
      class="px-1.5 sm:px-2 md:px-4 py-1 sm:py-1.5 rounded-full text-[11px] xs:text-xs sm:text-sm text-black dark:text-white
             hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
             transition-all duration-200 whitespace-nowrap"
    >
      Experiencia
    </a>

    <a
      href="#sobre-mi"
      class="px-1.5 sm:px-2 md:px-4 py-1 sm:py-1.5 rounded-full text-[11px] xs:text-xs sm:text-sm text-black dark:text-white
             hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
             transition-all duration-200 whitespace-nowrap"
    >
      Sobre mí
    </a>

    <a
      href="https://www.youtube.com/@horaciobriceno4230"
      target="_blank"
      class="px-1.5 sm:px-2 md:px-4 py-1 rounded-full flex items-center justify-center
         text-black dark:text-white
         hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
         transition-all duration-200"
    >
      <YoutubeNavbar
        class="w-4 h-4 sm:w-6 sm:h-6 md:w-8 md:h-8 transition-transform duration-200"
      />
    </a>
  </nav>
</header>
