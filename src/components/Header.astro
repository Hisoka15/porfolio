---
import YoutubeNavbar from "./icons/YoutubeNavbar.astro";
---

<header
  class="flex justify-center items-center mx-auto py-5 sticky top-0 w-full xl:w-[1120px] z-10"
>
  <nav
    class="flex flex-row items-center gap-2 px-4 py-2 rounded-full border border-white/10
           bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md shadow-lg"
  >
    <a
      href="#experiencia"
      class="px-4 py-1.5 rounded-full text-sm text-black dark:text-white
             hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
             transition-all duration-200"
    >
      Experiencia
    </a>

    <a
      href="#sobre-mi"
      class="px-4 py-1.5 rounded-full text-sm text-black dark:text-white
             hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
             transition-all duration-200"
    >
      Sobre mí
    </a>

    <a
      href="https://www.youtube.com/@horaciobriceno4230"
      target="_blank"
      class="px-4 py-1.5 rounded-full flex items-center justify-center
         text-black dark:text-white
         hover:bg-yellow-400/20 hover:text-yellow-600 dark:hover:text-yellow-300
         transition-all duration-200"
    >
      <YoutubeNavbar
        class="w-8 h-8 scale-125 transition-transform duration-200"
      />
    </a>
  </nav>
</header>
